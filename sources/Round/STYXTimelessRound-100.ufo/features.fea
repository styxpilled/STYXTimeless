    sub [A Agrave Aacute Acircumflex Atilde Adieresis Aring Amacron Abreve Aogonek M N Ntilde Nacute uni0145 Ncaron V W Wcircumflex Wgrave Wacute Wdieresis uni1E86 uni1E88 Z Zacute Zdotaccent Zcaron uni0410 uni0418 uni040D uni0419 uni041C v w wcircumflex wgrave wacute wdieresis uni1E87 uni1E89 z zacute zdotaccent zcaron uni0438 uni0439 uni045D uni043C uni0414.tri uni2116 uni01CD] by [A.sharp Agrave.sharp Aacute.sharp Acircumflex.sharp Atilde.sharp Adieresis.sharp Aring.sharp Amacron.sharp Abreve.sharp Aogonek.sharp M.sharp N.sharp Ntilde.sharp Nacute.sharp uni0145.sharp Ncaron.sharp V.sharp W.sharp Wcircumflex.sharp Wgrave.sharp Wacute.sharp Wdieresis.sharp uni1E86.sharp uni1E88.sharp Z.sharp Zacute.sharp Zdotaccent.sharp Zcaron.sharp uni0410.sharp uni0418.sharp uni040D.sharp uni0419.sharp uni041C.sharp v.sharp w.sharp wcircumflex.sharp wgrave.sharp wacute.sharp wdieresis.sharp uni1E87.sharp uni1E89.sharp z.sharp zacute.sharp zdotaccent.sharp zcaron.sharp uni0438.sharp uni0439.sharp uni045D.sharp uni043C.sharp uni0414.tri.sharp uni2116.sharp uni01CD.sharp];
} ss06;
# sharp.py end

# open_c.py
feature ss07 {
    sub [C Ccedilla Cacute Ccircumflex Cdotaccent Ccaron uni0421 c ccedilla cacute ccircumflex cdotaccent ccaron uni0441] by [C.open Ccedilla.open Cacute.open Ccircumflex.open Cdotaccent.open Ccaron.open uni0421.open c.open ccedilla.open cacute.open ccircumflex.open cdotaccent.open ccaron.open uni0441.open];
