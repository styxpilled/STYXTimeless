<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <axes>
    <axis tag="wght" name="Weight" minimum="100" maximum="900" default="400">
      <labels>
        <label uservalue="100" name="Hairline"/>
        <label uservalue="200" name="Thin"/>
        <label uservalue="300" name="Light"/>
        <label uservalue="400" name="Book" linkeduservalue="700"/>
        <label uservalue="500" name="Medium"/>
        <label uservalue="600" name="Demi"/>
        <label uservalue="700" name="Bold"/>
        <label uservalue="800" name="Heavy"/>
        <label uservalue="900" name="Black"/>
      </labels>
    </axis>
    <axis tag="ital" name="Italic" minimum="0" maximum="1" default="0">
      <labels>
        <label uservalue="0" name="Roman" elidable="true" linkeduservalue="1"/>
        <label uservalue="1" name="Italic"/>
      </labels>
    </axis>
  </axes>
  <sources>
    <source filename="STYXTimeless-100.ufo" name="STYXTimeless-100" familyname="STYX Timeless" stylename="Hairline">
      <lib copy="1"/>
      <info copy="1"/>
      <location>
        <dimension name="Weight" xvalue="100"/>
        <dimension name="Italic" xvalue="0"/>
      </location>
    </source>
